# Copy to .env. UI settings override these defaults. No key is needed in demo mode.
LULULIAN_DATA_DIR=.data
AI_MODE=demo
# Compatible API base URL, including /v1; each capability can use a different provider.
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_MODEL=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=alloy
