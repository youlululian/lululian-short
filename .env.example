# Copy to .env. UI settings override these defaults. No key is needed in demo mode.
LULULIAN_DATA_DIR=.data
AI_MODE=demo
# Compatible API base URL, including /v1; each capability can use a different provider.
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_MODEL=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=alloy

# Optional independent script judge (blank model uses TEXT configuration)
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=
# local = Qwen-VL compatible server; gemini = Google native generateContent
VISION_BACKEND=local
VISION_BASE_URL=http://127.0.0.1:8001/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# local = SGLang H3; minimax = official MiniMax API, base https://api.minimax.io/v2
VIDEO_BACKEND=local
VIDEO_BASE_URL=http://127.0.0.1:30010/v1
VIDEO_API_KEY=
VIDEO_MODEL=MiniMax-H3
